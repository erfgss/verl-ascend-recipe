@@ -21,6 +21,51 @@ from functools import wraps
 from verl.utils.device import is_torch_npu_available
 
 
+def patch_vllm_ascend_routed_experts_local_padding():
+    """Teach the Ascend route capturer about pre-all-gather DP padding.
+
+    DSV4 decode MoE may route a local tensor padded to the largest token
+    count in the DP group.  The vllm-ascend capturer already handles the
+    corresponding *post*-all-gather layout (``max_tokens * dp_size``), but
+    not this local ``max_tokens`` layout.  Only the first
+    ``token_num_per_dp`` rows are real; the remaining rows are scheduler
+    padding and must not be returned as routes for generated tokens.
+
+    This patch is installed inside each vLLM worker after vllm-ascend has
+    applied its own capturer patch.  It intentionally leaves every other
+    layout to the existing implementation.
+    """
+    if not is_torch_npu_available(check_device=False):
+        return
+
+    from vllm.forward_context import get_forward_context
+    from vllm.model_executor.layers.fused_moe.routed_experts_capturer import RoutedExpertsCapturer
+
+    original_capture = RoutedExpertsCapturer.capture
+    if getattr(original_capture, "_verl_ascend_local_dp_padding", False):
+        return
+
+    @wraps(original_capture)
+    def capture_with_local_dp_padding(self, layer_id, topk_ids):
+        ctx = get_forward_context()
+        if ctx.dp_metadata is not None:
+            num_tokens_dp = ctx.dp_metadata.num_tokens_across_dp_cpu
+            token_num_per_dp = int(num_tokens_dp[self.dp_rank].item())
+            max_tokens = int(num_tokens_dp.max().item())
+
+            # Before the DP all-gather, DSV4's bucketed decode path exposes a
+            # per-rank [max_tokens, topk] tensor.  Trim only this exact shape;
+            # global concatenated, padded-all-gather and SP layouts continue
+            # through the original vllm-ascend implementation unchanged.
+            if topk_ids.shape[0] == max_tokens and max_tokens > token_num_per_dp:
+                topk_ids = topk_ids[:token_num_per_dp]
+
+        return original_capture(self, layer_id, topk_ids)
+
+    capture_with_local_dp_padding._verl_ascend_local_dp_padding = True
+    RoutedExpertsCapturer.capture = capture_with_local_dp_padding
+
+
